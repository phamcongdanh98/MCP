{
  "name": "workspaceguard-mcp",
  "version": "0.1.0",
  "description": "A policy-first local workspace MCP server for safe file, Git, and command access.",
  "type": "module",
  "bin": {
    "workspaceguard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "SECURITY.md",
    "NOTICE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-desktop-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx tests/smoke.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "desktop": "npm run build && electron dist/desktop/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "electron": "44.0.0",
    "electron": "^44.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
